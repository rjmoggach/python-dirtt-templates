<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE dirtt PUBLIC "-//STUDIO//DTD dirtt 1.0//EN" "http://rjmoggach.github.io/python-dirtt/dtds/dirtt.dtd">
<dirtt name="Studio Project Tree 2026" version="1.0" dirname="{{project_root}}" basename="{{project_path}}" id="project-root" username="pipeline" group="artist" perms="02755" xmlns:xi="http://www.w3.org/2001/XInclude">

<!-- C O N F I G  : ocio + pipeline config live with the project -->
    <dir name="Project Config" basename="config" id="config" username="pipeline" group="pipeline" perms="02755">
        <dir basename="ocio" id="config-ocio" username="pipeline" group="pipeline" perms="02755"/>
        <dir basename="pipeline" id="config-pipeline" username="pipeline" group="pipeline" perms="02755"/>
        <dir basename="env" username="pipeline" group="pipeline" perms="02755"/>
    </dir>

<!-- I O  : everything that crosses the project boundary, dated -->
    <dir name="Project IO" basename="io" id="io" username="pipeline" group="artist" perms="02775">
        <dir basename="incoming" id="io-incoming" username="pipeline" group="artist" perms="02775">
            <dir basename="client" id="io-incoming-client"/>
            <dir basename="vendor" id="io-incoming-vendor"/>
        </dir>
        <dir basename="outgoing" id="io-outgoing" username="pipeline" group="artist" perms="02775">
            <dir basename="client" id="io-outgoing-client"/>
            <dir basename="vendor" id="io-outgoing-vendor"/>
        </dir>
        <dir basename="dropbox" id="io-dropbox" username="pipeline" group="artist" perms="02777"/>
    </dir>

<!-- A S S E T S  : was 'library' in 2015 -->
    <dir name="Project Assets" basename="assets" id="assets" username="pipeline" group="pipeline" perms="02775">
        <xi:include href="project_assets.xml" parse="xml"/>
    </dir>

<!-- F O O T A G E  : was 'media' in 2015 -->
    <dir name="Project Footage" basename="footage" id="footage" username="pipeline" group="artist" perms="02775">
        <xi:include href="project_footage.xml" parse="xml"/>
    </dir>

<!-- E D I T O R I A L  : was 'production/online' in 2015 -->
    <dir name="Project Editorial" basename="editorial" id="editorial" username="pipeline" group="artist" perms="02775">
        <dir basename="cuts" id="editorial-cuts"/>
        <dir basename="conform" id="editorial-conform"/>
        <dir basename="audio" id="editorial-audio"/>
        <dir basename="exports" id="editorial-exports"/>
    </dir>

<!-- P R O D U C T I O N  : business + creative, client io moved to /io -->
    <dir name="Project Production" basename="production" id="production" username="pipeline" group="production" perms="02775">
        <xi:include href="project_production.xml" parse="xml"/>
    </dir>

<!-- S H O T S -->
    <dir name="Project Shots" basename="shots" id="shots" username="pipeline" group="pipeline" perms="02775"/>

<!-- W O R K -->
    <dir name="Project Work" basename="work" id="work" username="pipeline" group="pipeline" perms="02775">
        <dir basename="users" id="work-users" username="pipeline" group="artist" perms="02775"/>
        <dir basename="dailies" id="work-dailies" username="pipeline" group="artist" perms="02775">
            <dir basename="YYYY-MM-DD_description" name="YYYY-MM-DD_description"/>
        </dir>
        <link basename="footage" idref="footage"/>
    </dir>

<!-- A P P S  : app-managed project stores -->
    <dir name="Project Apps" basename="apps" id="apps" username="pipeline" group="pipeline" perms="02775">
        <dir basename="flame" id="apps-flame" username="pipeline" group="artist" perms="02777"/>
    </dir>

<!-- D E L I V E R A B L E S -->
    <dir name="Project Deliverables" basename="deliverables" id="deliverables" username="pipeline" group="production" perms="02775">
        <dir basename="masters" id="deliverables-masters"/>
        <dir basename="versions" id="deliverables-versions"/>
    </dir>

</dirtt>
